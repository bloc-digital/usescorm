{
  "name": "@blocdigital/usescorm",
  "type": "module",
  "version": "0.4.0",
  "description": "React hook for communicating with the SCORM API.",
  "author": "Bloc Digital <web@bloc.digital>",
  "license": "MIT",
  "keywords": [
    "react",
    "react hook",
    "SCORM",
    "SCORM2004",
    "SCORM1.2",
    "learning",
    "LMS",
    "moodle"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bloc-digital/usescorm.git"
  },
  "homepage": "https://github.com/bloc-digital/usescorm/blob/main/README.md",
  "jest": {
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    }
  },
  "types": "dist/types/index.d.ts",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "bridge": [
        "dist/types/bridge/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./bridge": {
      "import": {
        "types": "./dist/types/bridge/index.d.ts",
        "default": "./dist/esm/bridge/index.js"
      },
      "require": {
        "types": "./dist/cjs/bridge/index.d.ts",
        "default": "./dist/cjs/bridge/index.js"
      }
    },
    "./host.js": "./dist/host/usescorm-host.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig-cjs.json && tsc -p tsconfig-types.json && node scripts/write-cjs-package.cjs && vite build --config vite.host.config.ts",
    "build:demo": "tsc -p demo/tsconfig.json && node scripts/build-demo.mjs",
    "lint": "eslint src demo --max-warnings 0",
    "preview": "vite preview",
    "test": "jest"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "babel-jest": "^30.5.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "bugs": {
    "url": "https://github.com/bloc-digital/usescorm/issues"
  },
  "peerDependencies": {
    "react": "^17 || ^18 || ^19",
    "react-dom": "^17 || ^18 || ^19"
  }
}
